<Window x:Class="ClaudeUsageMeter.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Claude Usage Meter"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.WindowFallback}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource Font.Text}" Icon="/Assets/app.ico">
    <StackPanel Margin="24,20,24,20">
        <StackPanel Orientation="Horizontal">
            <Image Source="/Assets/gauge-160.png" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Claude Usage Meter" Style="{StaticResource Text.Title}" FontSize="18"/>
                <TextBlock x:Name="VersionText" Text="Version" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,18,0,0"
                   Text="Your Claude plan usage at a glance. An independent, open-source tool."/>
        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                   Text="It reads usage only through the official Claude Code CLI (claude /usage), which costs no usage. It never reads your sign-in tokens, never calls Anthropic's servers itself, and sends no telemetry."/>
        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                   Text="Not affiliated with or endorsed by Anthropic. Claude is a trademark of Anthropic."/>
        <TextBlock Style="{StaticResource Text.Faint}" TextWrapping="Wrap" Margin="0,10,0,0"
                   Text="Copyright 2026 Lohan Ramachandran. Released under the MIT licence."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Check for a new version" Style="{StaticResource SubtleButton}" Click="Releases_Click"
                    ToolTip="Opens the releases page in your browser. Nothing is downloaded automatically."/>
            <Button Content="Close" Style="{StaticResource AccentButton}" Margin="8,0,0,0" MinWidth="80" Click="Close_Click" IsDefault="True" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
