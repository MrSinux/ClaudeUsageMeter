<Window x:Class="ClaudeUsageMeter.Views.StripWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ClaudeUsageMeter.Views"
        xmlns:vm="clr-namespace:ClaudeUsageMeter.ViewModels"
        Title="Claude Usage Meter strip"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        SizeToContent="Width" Height="48"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource Font.Text}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <!-- Near-transparent fill so the whole strip is clickable and draggable. -->
    <Border x:Name="Surface" Margin="0,4" CornerRadius="4" Padding="8,0" Background="#01000000" Cursor="Hand"
            ToolTipService.InitialShowDelay="600">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Brush.ButtonHover}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid VerticalAlignment="Center">
            <ItemsControl ItemsSource="{Binding StripBlocks}" Focusable="False"
                          Visibility="{Binding StripHasBlocks, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:BlockViewModel}">
                        <StackPanel x:Name="Cell" Margin="5,0" Width="58" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock Text="{Binding ShortLabel}" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" Margin="0,0,30,1"/>
                                <TextBlock x:Name="Pct" Text="{Binding PercentText}" Style="{StaticResource LevelNumber}" FontSize="12"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                            </Grid>
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource Brush.Track}" Margin="0,3,0,0">
                                <Border Style="{StaticResource LevelFill}" CornerRadius="2" HorizontalAlignment="Left" MinWidth="4" Width="0"
                                        v:BarFill.Fraction="{Binding Fraction}"/>
                            </Border>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                <Setter TargetName="Cell" Property="Width" Value="70"/>
                                <Setter TargetName="Pct" Property="FontSize" Value="14"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Nothing to show: an honest placeholder -->
            <StackPanel Orientation="Horizontal" Margin="4,0" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StripHasBlocks}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Image Source="/Assets/gauge-64.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,8,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="--" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"/>
                    <TextBlock Text="{Binding StripProblemText}" FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
