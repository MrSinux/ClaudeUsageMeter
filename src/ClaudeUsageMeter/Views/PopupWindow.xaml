<Window x:Class="ClaudeUsageMeter.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ClaudeUsageMeter.Views"
        xmlns:vm="clr-namespace:ClaudeUsageMeter.ViewModels"
        Title="Claude Usage Meter"
        Width="360" SizeToContent="Height"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        Background="Transparent"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource Font.Text}"
        d:DataContext="{d:DesignInstance vm:MeterViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border x:Name="Root" Background="{DynamicResource Brush.WindowTint}">
        <Grid x:Name="Body" Margin="16,12,16,12" RenderTransformOrigin="0.5,1">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="Slide"/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,-8,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="/Assets/gauge-64.png" Width="20" Height="20" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Grid.Column="1" Text="Claude Usage Meter" Style="{StaticResource Text.Title}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <Button x:Name="RefreshButton" Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="Refresh now" Click="Refresh_Click"
                        AutomationProperties.Name="Refresh now">
                    <TextBlock x:Name="RefreshGlyph" Text="&#xE72C;" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform x:Name="RefreshSpin"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Button>
                <Button x:Name="MenuButton" Grid.Column="3" Style="{StaticResource IconButton}" ToolTip="More" Click="Menu_Click"
                        AutomationProperties.Name="More options" Content="&#xE712;"/>
            </Grid>

            <!-- Sign-in banner -->
            <Border Grid.Row="1" Margin="0,0,0,10" Padding="12,10" CornerRadius="6"
                    Background="{DynamicResource Brush.BannerBack}" BorderBrush="{DynamicResource Brush.BannerBorder}" BorderThickness="1"
                    Visibility="{Binding HasSignInWarning, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Font.Icons}" FontSize="14" Foreground="{DynamicResource Brush.Amber}"
                               Margin="0,1,10,0" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding SignInWarning}" Style="{StaticResource Text.Body}" FontSize="12" TextWrapping="Wrap"/>
                        <Button Content="Sign in again" Style="{StaticResource SubtleButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Padding="10,4" FontSize="12" Click="SignIn_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="2">
                <!-- Blocks -->
                <ItemsControl ItemsSource="{Binding Blocks}" Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BlockViewModel}">
                            <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="1"
                                    CornerRadius="6" Padding="12,10,12,11" Margin="0,0,0,6">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body}" VerticalAlignment="Bottom"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,8,2"/>
                                        <TextBlock Grid.Column="1" Text="{Binding PercentText}" Style="{StaticResource LevelNumber}" FontSize="20"
                                                   VerticalAlignment="Bottom"/>
                                    </Grid>
                                    <Border Height="6" CornerRadius="3" Background="{DynamicResource Brush.Track}" Margin="0,7,0,7" ClipToBounds="False">
                                        <Border Style="{StaticResource LevelFill}" CornerRadius="3" HorizontalAlignment="Left" MinWidth="6" Width="0"
                                                v:BarFill.Fraction="{Binding Fraction}"/>
                                    </Border>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Countdown}" Style="{StaticResource Text.Caption}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ResetAt}" Style="{StaticResource Text.Faint}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Loading (first read) -->
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" Margin="0,18,0,22" HorizontalAlignment="Center">
                    <TextBlock Text="--" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Display}" FontSize="32"
                               Foreground="{DynamicResource Brush.TextTertiary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Reading usage from Claude Code..." Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Problem state: honest placeholder with a reason and one action -->
                <Border Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}" Background="{DynamicResource Brush.Card}"
                        BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="1" CornerRadius="6" Padding="16,16,16,16" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock Text="--" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Display}" FontSize="32"
                                   Foreground="{DynamicResource Brush.TextTertiary}"/>
                        <TextBlock Text="{Binding ProblemTitle}" Style="{StaticResource Text.Title}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding ProblemReason}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <Button Content="{Binding ProblemActionText}" Style="{StaticResource AccentButton}" HorizontalAlignment="Left"
                                Margin="0,12,0,0" Click="ProblemAction_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Footer -->
            <StackPanel Grid.Row="3" Margin="0,6,0,0">
                <TextBlock Text="{Binding StaleText}" Foreground="{DynamicResource Brush.Amber}"
                           TextWrapping="Wrap" Margin="0,0,0,6">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StaleText}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource Text.Faint}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
